{
  "name": "maxfit",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "MaxFit - a gym and fitness tracker that plays like a game: unlock exercises, beat your records, evolve your avatar.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node tests/e2e/smoke.mjs",
    "balance": "tsx scripts/balance-sim.ts",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:android": "npx cap add android",
    "screens": "node tests/e2e/screens.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource/cinzel": "^5.1.0",
    "@supabase/supabase-js": "^2.119.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
